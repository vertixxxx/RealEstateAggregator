# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# Dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# Environment variables (CRITICAL - DO NOT COMMIT)
.env
.env*
!.env.example

# Python cache & Virtual environments
__pycache__/
*.py[cod]
*$py.class
venv/
.venv/
env/

# Testing & Coverage
/coverage

# Next.js & Build outputs
/.next/
/out/
/build

# Misc
.DS_Store
*.pem

# Debug logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Vercel & TypeScript
.vercel
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma